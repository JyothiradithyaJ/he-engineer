# Server
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string

# Groq (https://console.groq.com/keys) - required for the HR chatbot
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Comma separated origins allowed to call this API (your deployed frontend URL)
CLIENT_ORIGIN=http://localhost:5173
